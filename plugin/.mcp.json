{
  "mcpServers": {
    "moodle": {
      "command": "uvx",
      "args": [
        "moodle-obsidian-mcp==0.8.2"
      ],
      "env": {
        "CLAUDE_PLUGIN_OPTION_VAULT_DIR": "${user_config.vault_dir}",
        "CLAUDE_PLUGIN_OPTION_LANGUAGE": "${user_config.language}",
        "CLAUDE_PLUGIN_OPTION_MOODLE_URL": "${user_config.moodle_url}",
        "CLAUDE_PLUGIN_OPTION_MOODLE_TOKEN": "${user_config.moodle_token}"
      }
    }
  }
}
