# ATENÇÃO: o .env é o mecanismo LEGADO. Continua a ser lido (camada 4 de 4), mas
# a configuração passou para o diretório do utilizador. Ver:
#     moodle-mcp --show-config
#
# Tudo o que está aqui funciona igualmente como variável de ambiente, que tem
# precedência sobre os ficheiros — é a forma recomendada de passar configuração
# a partir de um cliente MCP.

# --- Instâncias Moodle: MOODLE_<NOME>_URL e MOODLE_<NOME>_TOKEN ---
# O <NOME> é à tua escolha e é o que passas em instance="<nome>".
MOODLE_UAB_URL=https://elearning.uab.pt
MOODLE_UAB_TOKEN=

MOODLE_UTAD_URL=https://e-learning.utad.pt
MOODLE_UTAD_TOKEN=

# Qual delas é usada quando a ferramenta não indica nenhuma
MOODLE_DEFAULT_INSTANCE=uab

# --- Alternativa de instância única (retrocompatível) ---
# MOODLE_URL e MOODLE_TOKEN sem nome formam a instância predefinida, mas são
# ignorados se existir qualquer instância nomeada acima.
# MOODLE_URL=https://elearning.uab.pt
# MOODLE_TOKEN=

# Vault do Obsidian: único diretório onde o servidor lê e escreve ficheiros
OBSIDIAN_VAULT_DIR=~/Doutoramento

# (Opcional) Toolsets a expor; vazio = core,grades,forums,obsidian,write
MOODLE_MCP_TOOLS=
