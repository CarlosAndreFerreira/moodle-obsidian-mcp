# URL da instância principal do Moodle (ex.: Universidade Aberta)
MOODLE_URL=https://elearning.uab.pt
MOODLE_TOKEN=

# (Opcional) Segunda instância do Moodle (ex.: UTAD)
MOODLE_UTAD_URL=https://e-learning.utad.pt
MOODLE_UTAD_TOKEN=

# Caminho para o cofre (Vault) do Obsidian onde serão sincronizadas as disciplinas, PDFs e fóruns
OBSIDIAN_VAULT_DIR=~/Doutoramento
