# ATENÇÃO: o .env é o mecanismo LEGADO. Continua a ser lido (camada 4 de 5), mas
# a configuração passou para o diretório do utilizador. Ver:
#     moodle-mcp --show-config
#
# As variáveis abaixo funcionam igualmente como variáveis de ambiente, que têm
# precedência sobre todos os ficheiros — é a forma recomendada de as passar a
# partir da configuração de um cliente MCP.

MOODLE_URL=https://elearning.uab.pt
MOODLE_TOKEN=

# (Opcional) Segunda instância do Moodle
MOODLE_UTAD_URL=https://e-learning.utad.pt
MOODLE_UTAD_TOKEN=

# Vault do Obsidian: único diretório onde o servidor lê e escreve ficheiros
OBSIDIAN_VAULT_DIR=~/Doutoramento

# (Opcional) Toolsets a expor; vazio = core,grades,forums,obsidian,write
MOODLE_MCP_TOOLS=
