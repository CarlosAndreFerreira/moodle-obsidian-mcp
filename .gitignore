# Security: NEVER commit tokens, session cookies, or auth logs.
# These patterns are deliberately specific. A blunt `*token*` also matched
# moodle_mcp/token_catcher.py, and because the build backend reads this file
# to pick what to package, the module was silently dropped from built wheels
# while its console script stayed declared.
.env
.env.*
!.env.example
*.log
last_auth.log
credentials.json
*.token
*_token.json
.moodle/

# Virtual environments & Python cache
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.ruff_cache/
.pytest_cache/

# IDE & OS
.vscode/
.idea/
.DS_Store
